window-rule {
    opacity 0.95
    clip-to-geometry true
    draw-border-with-background false
}

window-rule {
  background-effect {
    blur true
    xray true
  }
}

layer-rule {
  match namespace="^noctalia-overview*"
  place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia*"
    background-effect {
      xray false
    }
}

window-rule {
  match app-id=r#"^brave*"#
  match app-id=r#"^firefox*"#

  open-maximized true
}

window-rule {
  match app-id="firefox$" title="^Picture-in-Picture$"
  match title=r#"[Pp]icture [Ii]n [Pp]icture"#

  open-floating true
  default-column-width { fixed 720; }
  default-window-height { fixed 405; }
}

window-rule {
  match app-id="^qt6ct$"
  match app-id="^qt5ct$"
  match title="^Kvantum Manager$"

  match app-id="^qalculate-gtk$"
  match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
  match app-id=r#"^org\.gnome\.FileRoller$"#
  match app-id=r#"^org\.gnome\.seahorse\.Application$"#
  match app-id="^imv$"
  match title=r#"^Rename*"#
  
  match app-id="^xdg-desktop-portal-gtk$"
  
  open-floating true
}

window-rule {
    match app-id="^vesktop$"
    match app-id=r#"^org\.gnome\.seahorse\.Application$"#

    block-out-from "screencast"
}