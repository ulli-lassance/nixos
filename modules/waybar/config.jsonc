{
  "layer": "bottom",
  "position": "top",
  "height": 0,

  "modules-left": [
    "custom/l_border",
    "clock",
    "custom/r_border",

    "custom/l_border",
    "pulseaudio#output",
    "pulseaudio#input",
    "mpris",
    "custom/r_border"
  ],

  "modules-center": ["hyprland/workspaces"],

  "modules-right": [
    "wlr/taskbar",
    "tray",

    "custom/l_border",
    "custom/screenshot",
    "network",
    "custom/updates",
    "hyprland/language",
    "custom/r_border",

    "custom/l_border",
    "cpu",
    "memory#ram",
    // "temperature",
    "custom/r_border",

    "custom/power"
  ],
  "include": ["~/.config/waybar/modules.jsonc"]
}
