{
  "hyprland/workspaces": {
      "format": "{icon}",
      "format-icons": {
          "active": "",
          "default": "",
          "empty": ""
      },
      "persistent-workspaces": {
          "*": 5
      }
  },

  "tray": {
    "icon-size": 24,
    "spacing": 8,
    "show-passive-items": true
  },

  "hyprland/window": {
    "format": "<span weight='bold'>{class}</span>",
    "max-length": 120,
    "icon": false
  },

  "wlr/taskbar": {
    "all-outputs": false,
    "active-first": false,
    "markup": true,
    "format": "{icon}",
    "rotate": 0,
    "icon-size": 24,
    "spacing": 0,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  },

  "hyprland/language": {
    "format": "󰌌 {}",
    "format-pt": "br",
    "format-en": "eng",
    "tooltip-format": "Keyboard Layout",
    "on-click": "~/.config/hypr/scripts/cycle_kb_layout.sh"

  },

  "custom/screenshot": {
    "format": " ",
    "tooltip-format": " Left-click: Capture region\n Right-click: Capture full screen",
    "on-click": "hyprshot -zm region -o ~/Pictures/Screenshots",
    "on-click-right": "hyprshot -zm output -o ~/Pictures/Screenshots"

  },

  "network": {
        "tooltip": true,
        "format-wifi": "  {essid} ",
        "format-ethernet": "󰈀 ",
        "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
        "format-linked": "󰈀 {ifname} (No IP) ",
        "format-disconnected": "󱘖 ",
        "tooltip-format-disconnected": "Disconnected",
        "format-alt": " {bandwidthDownBytes}  {bandwidthUpBytes} ",
        "interval": 2
    },


  "custom/updates": {
    "format": "{}",
    "interval": 10800, // 3h
    "exec": "~/.config/waybar/scripts/updatecheck",
    "return-type": "json",
    "exec-if": "exit 0",
    "on-click": "~/.config/waybar/scripts/update_packages.sh",
    "signal": 8
  },

  "pulseaudio#output": {
    "format": "{icon} {volume}% ",
    "format-bluetooth": "{icon}  {volume}% ",
    "format-muted": " Muted ",
    "format-icons": {
      "default": ["", "", "", ""]
    },
    "on-click": "~/.config/hypr/scripts/volume mute",
    "on-click-right": "pgrep pavucontrol-qt > /dev/null 2>&1 && killall pavucontrol-qt || pavucontrol-qt",
    "on-scroll-up": "~/.config/hypr/scripts/volume up",
    "on-scroll-down": "~/.config/hypr/scripts/volume down",
    "tooltip": false,
    "scroll-step": 5
  },

  "pulseaudio#input": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " Muted",
    "on-click": "pamixer --default-source -t",
    "on-click-right": "pgrep pavucontrol-qt > /dev/null 2>&1 && killall pavucontrol-qt || pavucontrol-qt",
    "on-scroll-up": "pamixer --default-source -i 5",
    "on-scroll-down": "pamixer --default-source -d 5",
    "tooltip": false,
    "scroll-step": 5
  },

  "mpris": {
    "format": " {status_icon} {dynamic}",
    "dynamic-len": 50,
    "status-icons": {
      "playing": "⏸",
      "paused": "▶"
    },
    "dynamic-order": ["title", "artist"]
  },

  "cpu": {
    "format": " {usage}% ",
    "interval": 1,
    "states": {
      "warning": 80,
      "critical": 95
    },
    "on-click": "kitty btop &"
  },

  "memory#ram": {
    "format": " {percentage}%",
    "interval": 1,
    "states": {
      "warning": 80,
      "critical": 95
    },
    "tooltip-format": "{used}/{total} GiB",
    "on-click": "kitty btop &"
  },

  "temperature": {
    "interval": 10,
    "hwmon-path": "/sys/class/hwmon/hwmon5/temp1_input",
    "critical-threshold": 95,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", "", "", ""],
    "tooltip": false,
    "on-click": "kitty btop &"
  },

  "clock": {
    "format": "{:%A %d/%m - %I:%M %p}",
    "format-alt": "{:L%I:%M:%S %p}",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>"
  },

  "custom/power": {
    "on-click": "~/.config/rofi/scripts/toggle-power-menu.sh",
    "format": "",
    "tooltip": false
  },

  "custom/l_border": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },

  "custom/r_border": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  }
}