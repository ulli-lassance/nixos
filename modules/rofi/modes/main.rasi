configuration {
	font:							"JetBrainsMono Nerd Font Propo 14";
    show-icons:                     true;
    display-drun: 					"";
    drun-display-format:            "{name}";
    disable-history:                false;
	sidebar-mode: 					false;
}

@import "colors.rasi"

window {
    transparency:       "real";
    background-color:   @background;
    text-color:         @text;
    border:             2px;
    border-color:       @border;
    border-radius:      5px;
    width:              18%;
    location:           center;
    x-offset:           0;
    y-offset:           0;
}

prompt {
    enabled: 						true;
	padding: 						0% 0% 0% 0.3%;
	background-color: 				@transparent;
	text-color: 					@text;
	font:							"JetBrainsMono Nerd Font Propo 20";
    placeholder:                    "";
}

entry {
    background-color:               @transparent;
    text-color:                     @text;
    placeholder-color:              @text;
    expand:                         true;
    horizontal-align:               0;
    placeholder:                    "Search";
    font:			    			"JetBrainsMono Nerd Font Propo Bold 14";
    padding:                        0.45% 0px 0px 0.7%;
    blink:                          true;
}

inputbar {
    children:           [ prompt , entry ];
    background-color:   @alt-background;
    text-color:         @background;
    expand:             false;
    border:             0% 0% 0% 0%;
    border-radius:      0px;
    border-color:       @alt-background;
    margin:             0% 0% 0% 0%;
    padding:            12px;
}

listview {
    background-color:   @transparent;
    padding:            0px;
    columns:            1;
    lines:              10;
    spacing:            0%;
    cycle:              false;
    dynamic:            true;
    layout:             vertical;
    fixed-height:       true;
}

mainbox {
    background-color:               @transparent;
	border:							0% 0% 0% 0%;
    border-radius:                  0% 0% 0% 0%;
	border-color:					@alt-background;
    children:                       [ inputbar, listview ];
    spacing:                       	0%;
    padding:                        0%;
}

element {
    background-color:   @transparent;
    text-color:         @text;
    orientation:        horizontal;
    border-radius:      0%;
    padding:            12px 6px 12px 6px;
}

element-icon {
    background-color: 				inherit;
    text-color:       				inherit;
    horizontal-align:               0.5;
    vertical-align:                 0.5;
    size:                           28px;
    border:                         0px;
    padding:                        0 10px 0 10px;
}

element-text {
    background-color: 				@transparent;
    text-color:       				inherit;
    expand:                         true;
    horizontal-align:               0;
    vertical-align:                 0.5;
    margin:                         0% 0.25% 0% 0.25%;
}

element selected {
    background-color:               @bg-select;
    text-color:                     @text;
	border:							0% 0% 0% 0%;
    border-radius:                  0px;
    border-color:                  	@background;
}

error-message {
    padding: 2%;
    margin: 1%;
}

error-message, textbox {
    text-color:                     @text;
    background-color:               @background;
}   