#!/bin/bash

# --- Dependency Check ---
REQUIRED_COMMANDS=("chromium" "gum" "curl")
MISSING_COMMANDS=()

for cmd in "${REQUIRED_COMMANDS[@]}"; do
  if ! command -v "$cmd" &> /dev/null; then
    MISSING_COMMANDS+=("$cmd")
  fi
done

if [ ${#MISSING_COMMANDS[@]} -gt 0 ]; then
  echo -e "\e[31mError: Missing required dependencies:\e[0m" >&2
  for cmd in "${MISSING_COMMANDS[@]}"; do
    echo "  - $cmd" >&2
  done
  echo -e "\nPlease install them to continue." >&2
  exit 1
fi
# --- End Dependency Check ---

# --- Global Vars ---
ICON_DIR="$HOME/.local/share/applications/icons"
DESKTOP_DIR="$HOME/.local/share/applications/"

show_help() {
  cat <<EOF
Usage: $(basename "$0") [command] [options]

Manage web applications as desktop entries.
If no command is provided, an interactive menu will be shown.

Commands:
  install, -i      Install a new web app.
                   Arguments (for non-interactive use):
                     "App Name" "https://url.com" "https://icon.url/icon.png"

  remove, -r       Remove one or more existing web apps.
                   Arguments (for non-interactive use):
                     "App Name 1" "App Name 2"

  help, -h         Show this help message.
EOF
}

# --- Install Function ---
do_install() {
  # Local variables for this function
  local APP_NAME APP_URL ICON_REF CUSTOM_EXEC MIME_TYPES INTERACTIVE_MODE
  local ICON_PATH EXEC_COMMAND DESKTOP_FILE

  # Check if arguments were passed to this function
  if [ "$#" -lt 3 ]; then
    # No args, run interactive mode
    echo -e "\e[32mLet's create a new web app...\n\e[0m"
    APP_NAME=$(gum input --prompt "Name> " --placeholder "My favorite web app")
    APP_URL=$(gum input --prompt "URL> " --placeholder "https://example.com")
    ICON_REF=$(gum input --prompt "Icon URL> " --placeholder "See https://dashboardicons.com (must use PNG.)")
    CUSTOM_EXEC=""
    MIME_TYPES=""
    INTERACTIVE_MODE=true
  else
    # Args provided, use them
    APP_NAME="$1"
    APP_URL="$2"
    ICON_REF="$3"
    CUSTOM_EXEC="$4" # Optional custom exec command
    MIME_TYPES="$5"  # Optional mime types
    INTERACTIVE_MODE=false
  fi

  # Ensure valid execution
  if [[ -z "$APP_NAME" || -z "$APP_URL" || -z "$ICON_REF" ]]; then
    echo "You must set app name, app URL, and icon URL."
    return 1 # Use return 1 in a function, not exit 1
  fi

  # Ensure the icon directory exists
  if [ ! -d "$ICON_DIR" ]; then
    echo "Creating icon directory: $ICON_DIR"
    mkdir -p "$ICON_DIR"
  fi

  # Refer to local icon or fetch remotely from URL
  if [[ $ICON_REF =~ ^https?:// ]]; then
    ICON_PATH="$ICON_DIR/$APP_NAME.png"
    echo "Downloading icon to $ICON_PATH..."
    if curl -sL -o "$ICON_PATH" "$ICON_REF"; then
      ICON_PATH="$ICON_DIR/$APP_NAME.png"
    else
      echo "Error: Failed to download icon."
      return 1
    fi
  else
    ICON_PATH="$ICON_DIR/$ICON_REF"
  fi

  # Use custom exec if provided, otherwise default behavior
  if [[ -n $CUSTOM_EXEC ]]; then
    EXEC_COMMAND="$CUSTOM_EXEC"
  else
    EXEC_COMMAND="chromium --app=$APP_URL"
  fi

  # Create application .desktop file
  DESKTOP_FILE="$DESKTOP_DIR/$APP_NAME.desktop"

  echo "Creating desktop file: $DESKTOP_FILE"
  cat >"$DESKTOP_FILE" <<EOF
[Desktop Entry]
Version=1.0
Name=$APP_NAME
Comment=$APP_NAME
Exec=$EXEC_COMMAND
Terminal=false
Type=Application
Icon=$ICON_PATH
StartupNotify=true
EOF

  # Add mime types if provided
  if [[ -n $MIME_TYPES ]]; then
    echo "MimeType=$MIME_TYPES" >>"$DESKTOP_FILE"
  fi

  chmod +x "$DESKTOP_FILE"

  if [[ $INTERACTIVE_MODE == true ]]; then
    echo -e "\n\e[32mSuccess!\e[0m $APP_NAME has been created.\n"
  fi
}

# --- Remove Function ---
do_remove() {
  # Local variables for this function
  local WEB_APPS=()
  local SORTED_WEB_APPS
  local APP_NAMES_STRING
  local APP_NAMES=()
  local file line APP_NAME

  if [ "$#" -eq 0 ]; then
    # No args, run interactive mode
    while IFS= read -r -d '' file; do
      if grep -q '^Exec=.*chromium --app=.*' "$file"; then
        WEB_APPS+=("$(basename "${file%.desktop}")")
      fi
    done < <(find "$DESKTOP_DIR" -name '*.desktop' -print0)

    if ((${#WEB_APPS[@]})); then
      IFS=$'\n' SORTED_WEB_APPS=($(sort <<<"${WEB_APPS[*]}"))
      unset IFS
      APP_NAMES_STRING=$(gum choose --no-limit --header "Select web app to remove..." --selected-prefix="✗ " "${SORTED_WEB_APPS[@]}")
      # Convert newline-separated string to array
      while IFS= read -r line; do
        [[ -n "$line" ]] && APP_NAMES+=("$line")
      done <<< "$APP_NAMES_STRING"
    else
      echo "No web apps to remove."
      return 1
    fi
  else
    # Args provided, use them
    APP_NAMES=("$@")
  fi

  if [[ ${#APP_NAMES[@]} -eq 0 ]]; then
    echo "You must select at least one web app to remove."
    return 1
  fi

  for APP_NAME in "${APP_NAMES[@]}"; do
    echo "Removing $APP_NAME..."
    rm -f "$DESKTOP_DIR/$APP_NAME.desktop"
    rm -f "$ICON_DIR/$APP_NAME.png"
    echo "Removed $APP_NAME"
  done
}

# --- Main Script Logic ---
COMMAND="$1"

if [[ -n "$COMMAND" ]]; then
  # A command was passed (e.g., install or remove)
  shift # Remove the command ($1) from the argument list
  case "$COMMAND" in
    install | -i)
      do_install "$@" # Pass the rest of the arguments to the function
      ;;
    remove | -r)
      do_remove "$@" # Pass the rest of the arguments to the function
      ;;
    help | -h)
      show_help
      ;;
    *)
      echo "Unknown command: $COMMAND" >&2
      echo
      show_help
      exit 1
      ;;
  esac
else
  # No command passed, show interactive gum prompt
  CHOICE=$(gum choose "Install" "Remove" "Exit")
  
  case "$CHOICE" in
    Install)
      do_install
      ;;
    Remove)
      do_remove
      ;;
    Exit)
      echo "Exiting."
      exit 0
      ;;
    *)
      # Handle empty choice (e.g., user presses Esc)
      echo "No option selected. Exiting."
      exit 0
      ;;
  esac
fi
